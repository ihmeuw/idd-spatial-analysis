# Copy this file to paths.yaml (gitignored) and edit the values for your machine.
# paths.yaml is the ONLY file in this repo allowed to contain absolute paths. The placeholder
# values use /your/cluster/path/... by design so they do not trip the no-absolute-paths guard.
# Every loader also accepts these roots as explicit arguments; paths.yaml is the convenience
# for the cluster, not a requirement of the package.

# Directory holding dated LBD standard admin shapefile releases (e.g. 2024_07_29/ beneath it).
admin_shapefile_root: /your/cluster/path/admin_shapefiles

# Directory holding the building-density tile indexes: <resolution>m/tile_index.parquet beneath it.
tile_index_root: /your/cluster/path/building-density/tiles

# Gridded population rasters on the tile index frame. The package never assumes a layout
# beneath it: pass the raster you want to read_window or mosaic explicitly.
population_grid_root: /your/cluster/path/population-model

# Raking inputs: shapes_<hierarchy>.parquet, population_<hierarchy>.parquet, gbd-inputs/.
raking_root: /your/cluster/path/population-model/admin-inputs/raking

# This repo's output node (STANDARDS §Output management), used only if data is materialized.
project_output_root: /your/cluster/path/idd-spatial-analysis

# Keys of roots that may be written under (STANDARDS §Path safety). The CLI copies an LBD
# release only when project_output_root is listed here, e.g. write: [project_output_root].
write: []
